# Copy this file to .env.development (local work), .env.test (tests) or .env.production, and fill in the values.
# dotenv-flow loads .env.<NODE_ENV>. Real environment variables (CI, Vercel dashboard) override any file.
# Every variable below is REQUIRED: the app refuses to start, and says which one is wrong, if one is missing.

NODE_ENV=development            # development | test | production
PORT=4000
DATABASE_URL=mongodb://127.0.0.1:27017/media_library_dev   # MongoDB connection string. For NODE_ENV=test the database name must end in _test
JWT_SECRET=replace-me-with-a-random-string-of-32-or-more-characters   # reserved for the optional auth extension (the API does not use it yet)
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=uploads              # relative to the project folder, or an absolute path (on Vercel: /tmp/uploads)
LOG_LEVEL=debug                 # debug | info | warn | error
