{
  "info": {
    "name": "Media Library API",
    "description": "Tests for every Media Library API endpoint: status codes, response structure ({status,data} / {status,message}) and required fields.\n\nRun the 'Media (run in order)' folder top to bottom: the first request saves {{MEDIA_ID}}.\nFile uploads use the files in postman/fixtures: in Postman set the working directory to the postman folder (Settings > General > Working directory), or run with Newman: npx newman run postman/media-library-api.postman_collection.json -e postman/development.postman_environment.json --working-dir postman",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Content-Type is JSON', function () { pm.expect(pm.response.headers.get('Content-Type')).to.match(/application\\/json/); });",
                  "const body = pm.response.json();",
                  "pm.test('Body is { status: \"ok\", uptime, timestamp }', function () {",
                  "  pm.expect(body.status).to.eql('ok');",
                  "  pm.expect(body.uptime).to.be.a('number');",
                  "  pm.expect(new Date(body.timestamp).toISOString()).to.eql(body.timestamp);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/health",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Liveness check used for deployment monitoring."
          }
        }
      ]
    },
    {
      "name": "Media (run in order)",
      "item": [
        {
          "name": "POST /media - upload a PNG",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201 Created', function () { pm.response.to.have.status(201); });",
                  "pm.test('Content-Type is JSON', function () { pm.expect(pm.response.headers.get('Content-Type')).to.match(/application\\/json/); });",
                  "const body = pm.response.json();",
                  "pm.test('Response structure: { status: \"success\", data }', function () {",
                  "  pm.expect(body).to.have.property('status', 'success');",
                  "  pm.expect(body).to.have.property('data');",
                  "});",
                  "pm.test('Required fields are present', function () {",
                  "  const m = body.data.media;",
                  "  ['id','title','tags','category','filePath','originalName','mimeType','fileSize','createdAt','updatedAt'].forEach(function (f) {",
                  "    pm.expect(m, f).to.have.property(f);",
                  "  });",
                  "});",
                  "pm.test('Metadata and file information are stored', function () {",
                  "  const m = body.data.media;",
                  "  pm.expect(m.title).to.eql('Postman test image');",
                  "  pm.expect(m.tags).to.eql(['postman', 'test']);",
                  "  pm.expect(m.category).to.eql('design');",
                  "  pm.expect(m.mimeType).to.eql('image/png');",
                  "  pm.expect(m.originalName).to.eql('sample.png');",
                  "  pm.expect(m.fileSize).to.be.above(0);",
                  "});",
                  "pm.test('Location header points to the new item', function () {",
                  "  pm.expect(pm.response.headers.get('Location')).to.eql('/media/' + body.data.media.id);",
                  "});",
                  "pm.environment.set('MEDIA_ID', body.data.media.id); // used by the requests below"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/media",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "media"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "fixtures/sample.png"
                },
                {
                  "key": "title",
                  "value": "Postman test image",
                  "type": "text"
                },
                {
                  "key": "tags",
                  "value": "postman,test",
                  "type": "text"
                },
                {
                  "key": "category",
                  "value": "design",
                  "type": "text"
                }
              ]
            },
            "description": "Multipart upload: file + title, tags, category. Saves the new id in {{MEDIA_ID}}."
          }
        },
