{
  "name": "media-library-api",
  "version": "1.0.0",
  "description": "Media Library API prepared for production: Jest + Supertest tests, per-environment config, structured logging, /health, CI and Vercel deployment.",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "NODE_ENV=development node --watch server.js",
    "test": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js --runInBand --forceExit",
    "test:coverage": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js --coverage --runInBand --forceExit"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "dotenv-flow": "^4.1.0",
    "express": "^5.3.0",
    "mongoose": "^9.12.3",
    "multer": "^2.5.0",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.2"
  }
}
