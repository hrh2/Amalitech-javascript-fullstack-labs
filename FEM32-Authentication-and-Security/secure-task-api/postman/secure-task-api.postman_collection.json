{
  "info": {
    "name": "Secure Task API (FEM32)",
    "description": "Run the folders in order. Needs MongoDB, the API (`npm start`, default port 5000) and an admin created with `npm run create-admin -- \"Root Admin\" root.admin@example.com Admin-pass-123`. Folder 1 registers two fresh users (emails use {{runId}}) and stores {{tokenA}} / {{tokenB}}; folder 4 logs in as the admin and stores {{adminToken}}. Note: /auth/* is limited to 10 requests per 15 minutes per IP.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "tokenA",
      "value": ""
    },
    {
      "key": "tokenB",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "userAId",
      "value": ""
    },
    {
      "key": "userBId",
      "value": ""
    },
    {
      "key": "taskId",
      "value": ""
    },
    {
      "key": "badToken",
      "value": "abc.def.ghi"
    },
    {
      "key": "runId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Register and log in",
      "item": [
        {
          "name": "Register user A",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice\",\n  \"email\": \"alice_{{runId}}@example.com\",\n  \"password\": \"correct horse battery\",\n  \"role\": \"admin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// one value for the whole run, so Register and Login use the same email addresses",
                  "pm.collectionVariables.set('runId', Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('standard success format', () => pm.expect(pm.response.json().status).to.equal('success'));",
                  "const u = pm.response.json().data.user;",
                  "pm.collectionVariables.set('userAId', u.id);",
                  "pm.test('role is user even though the body asked for admin', () => pm.expect(u.role).to.equal('user'));",
                  "pm.test('no password or hash in the response', () => pm.expect(pm.response.text()).to.not.include('assword'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login user A",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice_{{runId}}@example.com\",\n  \"password\": \"correct horse battery\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('standard success format', () => pm.expect(pm.response.json().status).to.equal('success'));",
                  "pm.collectionVariables.set('tokenA', pm.response.json().data.token);",
                  "pm.test('token looks like a JWT', () => pm.expect(pm.response.json().data.token.split('.').length).to.equal(3));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register user B",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bob\",\n  \"email\": \"bob_{{runId}}@example.com\",\n  \"password\": \"correct horse battery\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('userBId', pm.response.json().data.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login user B",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"bob_{{runId}}@example.com\",\n  \"password\": \"correct horse battery\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('tokenB', pm.response.json().data.token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Protected routes",
      "item": [
        {
          "name": "Dashboard without a token (expect 401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/dashboard",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "dashboard"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('standard error format', () => pm.expect(pm.response.json().status).to.equal('error'));",
                  "pm.test('missing-token message', () => pm.expect(pm.response.json().message).to.equal('Access denied. No token provided.'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Dashboard with a token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/dashboard",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "dashboard"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('standard success format', () => pm.expect(pm.response.json().status).to.equal('success'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create task as A",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tasks"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Learn JWT\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('standard success format', () => pm.expect(pm.response.json().status).to.equal('success'));",
                  "const t = pm.response.json().data.task;",
                  "pm.collectionVariables.set('taskId', t.id);",
                  "pm.test('owned by user A', () => pm.expect(t.owner).to.equal(pm.collectionVariables.get('userAId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "List A's tasks",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tasks"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('A sees 1 task', () => pm.expect(pm.response.json().data.count).to.equal(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update A's task (PUT, owner)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tasks",
                "{{taskId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Learn JWT properly\",\n  \"completed\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('standard success format', () => pm.expect(pm.response.json().status).to.equal('success'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Tasks without a token (expect 401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tasks"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('standard error format', () => pm.expect(pm.response.json().status).to.equal('error'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Tasks with a garbage token (expect 401)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{badToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tasks"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('invalid-token message', () => pm.expect(pm.response.json().message).to.equal('Invalid token.'));"
                ]
              }
            }
          ]
        }
      ]
    },
