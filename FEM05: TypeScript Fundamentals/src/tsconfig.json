{
  "compilerOptions": {
    /* Project layout */
    "rootDir": "./src",
    "outDir": "./dist",

    /* Language & module target — modern browsers, native ES modules */
    "target": "es2020",
    "module": "es2020",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM"],

    /* Type safety — the whole point of this lab */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,

    /* Interop / output */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts"]
}
