{
  "name": "task-manager-app",
  "version": "1.0.0",
  "description": "Task Manager API Client with a Jest test suite (unit, integration, mocks & spies).",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "node main.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:watch": "node --experimental-vm-modules node_modules/.bin/jest --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/.bin/jest --coverage"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "models.js",
      "taskProcessor.js",
      "api.js",
      "!main.js"
    ],
    "coverageDirectory": "coverage",
    "coverageThreshold": {
      "global": {
        "statements": 80,
        "branches": 75,
        "functions": 85,
        "lines": 80
      }
    },
    "verbose": true
  },
  "author": "Hope HIRWA RUKUNDO",
  "license": "MIT"
}
